"""Run a bounded fresh workflow check through existing HTTP/SSE helpers.

Development cases and unused confirmation cases are separate. Each invocation
uses a new directory, sends each question once, and never retries paid tasks.
Gold and scoring criteria stay in this client, outside the investigated projects.
"""

import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import sys
import time

from dotenv import load_dotenv
import requests

from evaluation.source_search_v6_20261003.harness.run_comparison import emit, query, sha

ARCHIVE = Path(__file__).resolve().parent
REPO = ARCHIVE.parents[1]
REQUESTS_PIN = "b25c87d7cb8d6a18a37fa12442b5f883f9e41741"


def git(root, *args):
    return subprocess.check_output(["git", *args], cwd=root, text=True, encoding="utf-8").strip()


def prepare(root, requests_source):
    if root.exists():
        raise ValueError("Use a fresh workspace; existing files will not be replaced")
    if git(requests_source, "rev-parse", "HEAD") != REQUESTS_PIN or git(requests_source, "status", "--porcelain"):
        raise ValueError("Requests input must be the clean pinned source checkout")
    root.mkdir(parents=True)
    fixture = root / "support-search"
    shutil.copytree(ARCHIVE / "fixture", fixture)
    git(fixture, "init", "-q")
    git(fixture, "add", ".")
    git(fixture, "-c", "user.name=Workflow Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "Baseline workflow fixture")
    settings = fixture / "support_search/settings.py"
    settings.write_text(settings.read_text(encoding="utf-8").replace("DEFAULT_RESULT_LIMIT = 4", "DEFAULT_RESULT_LIMIT = 6"), encoding="utf-8")
    external = root / "requests"
    subprocess.run(["git", "clone", "--quiet", "--no-hardlinks", str(requests_source), str(external)], check=True, capture_output=True)
    sessions = external / "src/requests/sessions.py"
    text = sessions.read_text(encoding="utf-8")
    original = "if url.lower().startswith(prefix.lower()):"
    if text.count(original) != 1:
        raise ValueError("Unexpected pinned Requests source")
    sessions.write_text(text.replace(original, "if url.startswith(prefix):"), encoding="utf-8")
    emit({"prepared": True, "projects": [fixture.name, external.name], "provider_calls": 0})


@contextmanager
def server(project, output, corpus, candidate=False):
    runtime = output / ("runtime-" + project.name)
    runtime.mkdir()
    shutil.copy2(REPO / "config.yaml", runtime / "config.yaml")
    observation = output / (project.name + "-observations.jsonl")
    environment = dict(os.environ)
    environment.update({
        "ENGINEERING_PROJECT_ROOT": str(project),
        "ENGINEERING_KNOWLEDGE_CORPUS_ROOT": str(corpus),
        "ENGINEERING_CONVERSATION_DB": str(runtime / "conversations.sqlite3"),
        "ASSESSMENT_OBSERVATIONS": str(observation), "PYTHONPATH": str(REPO),
        "PYTHONIOENCODING": "utf-8", "HF_HUB_OFFLINE": "1",
        "TRANSFORMERS_OFFLINE": "1", "ANONYMIZED_TELEMETRY": "False",
        "CORE_WORKFLOW_CANDIDATE": "1" if candidate else "0",
    })
    if not environment.get("DEEPSEEK_API_KEY", "").strip():
        raise ValueError("Provider key missing")
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        port = sock.getsockname()[1]
    base = f"http://127.0.0.1:{port}"
    session = requests.Session()
    session.trust_env = False
    with (output / (project.name + "-server.log")).open("w", encoding="utf-8") as log:
        process = subprocess.Popen([
            sys.executable, "-m", "uvicorn", "evaluation.core_workflows_20261004.observe_server:app",
            "--host", "127.0.0.1", "--port", str(port), "--log-level", "warning",
        ], cwd=runtime, env=environment, stdout=log, stderr=subprocess.STDOUT,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
        try:
            deadline = time.monotonic() + 60
            while True:
                if process.poll() is not None:
                    raise RuntimeError("Server exited; inspect local log")
                try:
                    if session.get(base + "/health", timeout=2).status_code == 200:
                        break
                except requests.RequestException:
                    pass
                if time.monotonic() >= deadline:
                    raise RuntimeError("Startup timeout")
                time.sleep(.5)
            identity = session.get(base + "/project", timeout=5).json()
            knowledge = session.get(base + "/engineering/knowledge", timeout=5).json()
            capabilities = session.get(base + "/capabilities", timeout=5).json()
            if identity["project_name"] != project.name or not knowledge["verified"] or not knowledge["ready"] or not capabilities["features"]["engineering_agent"]:
                raise RuntimeError("Main path not ready or project identity mismatch")
            emit({"server_ready": project.name})
            yield session, base, observation
        finally:
            session.close()
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=5)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", type=Path, required=True)
    parser.add_argument("--prepare-from", type=Path)
    parser.add_argument("--phase", choices=("development", "confirmation"), default="development")
    parser.add_argument("--corpus-root", type=Path)
    parser.add_argument("--output-dir", type=Path)
    parser.add_argument("--live", action="store_true")
    parser.add_argument("--candidate", action="store_true", help="Explicit development-only prompt candidate")
    args = parser.parse_args()
    if args.prepare_from:
        prepare(args.workspace.resolve(), args.prepare_from.resolve())
        return
    catalog = json.loads((ARCHIVE / "catalog.json").read_text(encoding="utf-8"))
    cases = [c for c in catalog["cases"] if c["phase"] == args.phase]
    projects = {"fixture": args.workspace / "support-search", "requests": args.workspace / "requests"}
    for project in projects.values():
        if not project.is_dir():
            raise ValueError("Missing prepared project")
    if git(projects["requests"], "rev-parse", "HEAD") != REQUESTS_PIN:
        raise ValueError("External source pin mismatch")
    if not args.live:
        emit({"cases": len(cases), "phase": args.phase, "provider_calls": 0})
        return
    if args.output_dir is None or args.corpus_root is None:
        raise ValueError("Live mode requires corpus and fresh output directory")
    output = args.output_dir.resolve()
    if output.exists():
        raise ValueError("Use a fresh output directory; results are never overwritten")
    output.mkdir(parents=True)
    load_dotenv(REPO / ".env")
    inputs = [p for directory in ("api", "core", "ui") for p in (REPO / directory).rglob("*.py")]
    inputs += list(ARCHIVE.glob("*.py")) + [ARCHIVE / "catalog.json", REPO / "config.yaml"]
    manifest = {
        "started_utc": datetime.now(timezone.utc).isoformat(), "phase": args.phase,
        "planned_requests": len(cases), "paid_task_retries": 0, "candidate_override": args.candidate,
        "independent_acceptance": False, "code_head": git(REPO, "rev-parse", "HEAD"),
        "input_sha256": {str(p.relative_to(REPO)).replace("\\", "/"): sha(p) for p in sorted(inputs)},
        "projects": {alias: {"head": git(p, "rev-parse", "HEAD"), "status": git(p, "status", "--porcelain"),
            "source_sha256": {str(f.relative_to(p)).replace("\\", "/"): sha(f) for directory in ("support_search", "src", "tests", "docs") if (p / directory).exists() for f in sorted((p / directory).rglob("*")) if f.is_file() and ".git" not in f.parts and "__pycache__" not in f.parts},
            "readme_sha256": sha(p / "README.md")} for alias, p in projects.items()},
    }
    (output / "run_manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    count = 0
    for alias, project in projects.items():
        with server(project.resolve(), output, args.corpus_root.resolve(), args.candidate) as handle:
            for case in [c for c in cases if c["project"] == alias]:
                count += 1
                query(handle, case, args.phase, streaming=count % 2 == 0, count=count, output=output)
    changed = [name for name, expected in manifest["input_sha256"].items() if sha(REPO / name) != expected]
    if changed:
        raise RuntimeError("Runtime changed during matrix: " + ", ".join(changed))
    emit({"finished_requests": count, "phase": args.phase, "results_sha256": sha(output / "live_results.jsonl")})


if __name__ == "__main__":
    main()
