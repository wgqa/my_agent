# Copy to `.env` and fill in real values. Never commit `.env`.
# Only variable names and safe placeholders live here.
DEEPSEEK_API_KEY=
ENGINEERING_PROJECT_ROOT=
# Requirement M2: rule is the default; shadow records one candidate LLM plan
# without changing execution. Full llm/goal_v2 activation is not enabled yet.
ENGINEERING_REQUIREMENT_MODE=rule
# Optional local project registry SQLite file; default is beside the conversation database.
ENGINEERING_PROJECT_DB=
# Default product library; use verified only for historical corpus evaluation.
ENGINEERING_KNOWLEDGE_MODE=managed
# Optional explicit library SQLite file; default is data/runtime/engineering_knowledge.sqlite3.
ENGINEERING_KNOWLEDGE_DB=
# Optional verified 37-file corpus, imported only on first library initialization.
ENGINEERING_KNOWLEDGE_CORPUS_ROOT=
# Optional explicit SQLite file; default is data/runtime/engineering_conversations.sqlite3.
ENGINEERING_CONVERSATION_DB=
# Optional frontend backend address.
RAG_API_URL=http://127.0.0.1:8000
